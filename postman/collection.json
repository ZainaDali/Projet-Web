{
  "info": {
    "name": "Tests GraphQL Messenger - Résilient",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Register User A",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const timestamp = Date.now();",
              "pm.environment.set(\"usernameA\", `UserA_${timestamp}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "console.log('Réponse Register User A:', res);",
              "if (res.errors) { console.warn('⚠️ Erreurs GraphQL:', res.errors); }",
              "if (res.data && res.data.register) {",
              "  pm.test('Register User A exécutée avec succès', function () {",
              "    pm.expect(res.data.register.id).to.not.be.undefined;",
              "    pm.environment.set('userAId', res.data.register.id);",
              "  });",
              "} else {",
              "  console.warn('⚠️ Mutation Register User A a échoué ou aucune donnée retournée.');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"query\": \"mutation { register(data: { username: \\\"{{usernameA}}\\\", password: \\\"azerty123\\\" }) { id username createdAt } }\" }"
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [ "{{baseUrl}}" ],
          "path": [ "graphql" ],
          "protocol": "http"
        }
      }
    },
