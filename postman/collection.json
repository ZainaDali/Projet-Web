    {
      "name": "5 - Enqueue Message via BullMQ",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"query\": \"mutation { enqueueMessage(data: { content: \\\"BullMQ message\\\", senderId: \\\"{{userAId}}\\\", conversationId: \\\"{{conversationId}}\\\" }) }\" }"
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ],
          "protocol": "http"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "console.log('R\u00e9ponse enqueueMessage:', res);",
              "if (res.errors) { console.warn('\u26a0\ufe0f Erreurs GraphQL:', res.errors); }",
              "if (res.data && res.data.enqueueMessage) {",
              "  pm.test('Message enqueued', function () {",
              "    pm.expect(res.data.enqueueMessage).to.be.true;",
              "  });",
              "} else {",
              "  console.warn('\u26a0\ufe0f enqueueMessage a \u00e9chou\u00e9.');",
              "}"
            ]
          }
        }
      ]
    }
  ]
