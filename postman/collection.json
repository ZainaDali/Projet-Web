    {
      "name": "3 - Create Conversation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"query\": \"mutation { createConversation(data: { participantIds: [\\\"{{userAId}}\\\", \\\"{{userBId}}\\\"] }) { id createdAt participants { id username } } }\" }"
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ],
          "protocol": "http"
        }
      },
