{
  "info": {
    "name": "Tests GraphQL Messenger - R\u00e9silient",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Register User A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"query\": \"mutation { register(data: { username: \\\"UserA_1750173034\\\", password: \\\"azerty123\\\" }) { id username createdAt } }\" }"
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ],
          "protocol": "http"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "console.log('R\u00e9ponse Register User A:', res);",
              "if (res.errors) { console.warn('\u26a0\ufe0f Erreurs GraphQL:', res.errors); }",
              "if (res.data && res.data.register) {",
              "  pm.test('Register User A ex\u00e9cut\u00e9e avec succ\u00e8s', function () {",
              "    pm.expect(res.data.register.id).to.not.be.undefined;",
              "    pm.environment.set('userAId', res.data.register.id);",
              "  });",
              "} else {",
              "  console.warn('\u26a0\ufe0f Mutation Register User A a \u00e9chou\u00e9 ou aucune donn\u00e9e retourn\u00e9e.');",
              "}"
            ]
          }
        }
      ]
    },
