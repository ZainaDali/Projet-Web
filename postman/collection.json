            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"query\": \"mutation { sendMessage(data: { conversationId: \\\"{{conversationId}}\\\", senderId: \\\"{{userAId}}\\\", content: \\\"Hello direct\\\" }) { id content createdAt senderId } }\" }"
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
